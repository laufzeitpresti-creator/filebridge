{
  "name": "filebridge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source file distribution hub. Move files as-is between clouds, servers, the browser, and iPhone download links.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/crypto.test.ts lib/transfers/copy.test.ts lib/connectors/catalog.test.ts lib/security/ssrf.test.ts lib/security/rate-limit.test.ts",
    "audit": "npm audit --audit-level=high",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@electric-sql/pglite": "^0.5.8",
    "@number-flow/react": "^0.6.2",
    "@visx/event": "^4.0.1-alpha.0",
    "@visx/gradient": "^4.0.1-alpha.0",
    "@visx/grid": "^4.0.1-alpha.0",
    "@visx/pattern": "^4.0.1-alpha.0",
    "@visx/responsive": "^4.0.1-alpha.0",
    "@visx/scale": "^4.0.1-alpha.0",
    "@visx/shape": "^4.0.1-alpha.0",
    "aws4fetch": "^1.0.20",
    "basic-ftp": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.40.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "webdav": "^5.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
