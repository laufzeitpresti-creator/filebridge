# App (HTTPS in production — Vercel terminates TLS)
APP_URL=http://localhost:3000

# 32-byte key as 64 hex chars. Generate with: openssl rand -hex 32
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
FILEBRIDGE_KMS_KEY=

# Server-only database URL. Never expose as NEXT_PUBLIC_*.
# Local file DB (no Docker). Production: postgres://user:pass@host:5432/db?sslmode=require
# If you later use Supabase: browser gets the anon/public key + RLS; service role stays on the server.
DATABASE_URL=file:./data/filebridge.db

# Clerk — publishable key is the only public key. Secret key is server-only.
# Enable Clerk Bot Protection + login rate limits in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Microsoft Graph — Redirect: {APP_URL}/api/onedrive/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Google Drive — Redirect: {APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dropbox — Redirect: {APP_URL}/api/oauth/dropbox/callback
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Box — Redirect: {APP_URL}/api/oauth/box/callback
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Optional: where browser uploads and iPhone share files are stored
# FILEBRIDGE_DATA_DIR=./data

# Max browser upload size in bytes (default 100 MB)
# MAX_UPLOAD_BYTES=104857600
